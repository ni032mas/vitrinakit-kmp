#!/usr/bin/env bash
# Validates Conventional Commit messages.

set -euo pipefail

commit_msg_file="$1"
commit_msg="$(cat "$commit_msg_file")"

if echo "$commit_msg" | grep -qE "^Merge (branch|remote-tracking branch|tag) "; then
  exit 0
fi

if echo "$commit_msg" | grep -qE "^Revert \""; then
  exit 0
fi

if ! echo "$commit_msg" | grep -qE "^(feat|fix|docs|style|refactor|test|chore|build|ci|perf|revert)(\(.+\))?: .+"; then
  cat >&2 <<'EOF'

GIT HOOK: commit-msg
ERROR: Commit message must follow Conventional Commits.

Expected:
  type(scope): description

Allowed types:
  feat, fix, docs, style, refactor, test, chore, build, ci, perf, revert

Examples:
  chore: align repository workflow
  fix(sdk): map checkout errors
EOF
  exit 1
fi
